# --- Embeddings ---
EMBEDDING_PROVIDER=local          # local | openai | hash (hash = offline, for tests/demos)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
VECTOR_STORE=chroma               # chroma | memory
STORAGE_DIR=./storage

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- LLM ---
LLM_PROVIDER=ollama               # openai | groq | ollama | mock
LLM_MODEL=llama3.1
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

LOG_LEVEL=INFO
